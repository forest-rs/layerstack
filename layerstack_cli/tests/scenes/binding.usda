#usda 1.0
def Xform "World" (
    prepend apiSchemas = ["MaterialBindingAPI"]
) {
    rel material:binding = </Looks/Paint>
    def Mesh "Mesh" {}
}
def Scope "Looks" {
    def Material "Paint" {
        token outputs:surface.connect = </Looks/Paint/Surface.outputs:surface>
        def Shader "Surface" {
            uniform token info:id = "UsdPreviewSurface"
            token outputs:surface
        }
    }
}
