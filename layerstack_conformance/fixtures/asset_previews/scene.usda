#usda 1.0
(
    defaultPrim = "Asset"
)

def "WeakAsset" (
    assetInfo = {
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./weak_thumb.png@
                    int sibling = 1
                }
            }
        }
        string name = "weak"
    }
)
{
}

def Xform "Asset" (
    prepend apiSchemas = ["AssetPreviewsAPI"]
    prepend references = </WeakAsset>
)
{
    def Xform "Child"
    {
    }
}

