#usda 1.0

def Xform "World" (
    kind = "assembly"
)
{
    float xformOp:rotateZ = 23
    double3 xformOp:translate = (3, 4, 5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

    def Xform "Model" (
        kind = "component"
    )
    {
        float xformOp:rotateZ = 31
        double3 xformOp:translate = (2, -3, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "Tilt"
        {
            float xformOp:rotateZ = 17
            double3 xformOp:translate = (1, 2, 3)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Mesh "A"
            {
                float3[] extent = [(-1, -2, -3), (2, 3, 4)]
                float3[] extent.timeSamples = {
                    0: [(-2, -3, -4), (3, 4, 5)],
                    2: [(-4, -5, -6), (5, 6, 7)],
                }
            }

            def Mesh "Render"
            {
                float3[] extent = [(-1, -2, -3), (2, 3, 4)]
                uniform token purpose = "render"
            }
        }

        def Xform "Reset"
        {
            float xformOp:rotateZ = 13
            double3 xformOp:translate = (8, 0, 0)
            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:rotateZ"]

            def Mesh "B"
            {
                float3[] extent = [(-1, -2, -3), (2, 3, 4)]
            }
        }

        def Xform "Hidden"
        {
            token visibility = "invisible"
            float xformOp:rotateZ = 12
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Mesh "Leaf"
            {
                float3[] extent = [(-1, -2, -3), (2, 3, 4)]
            }
        }

        def Mesh "HiddenMesh"
        {
            float3[] extent = [(-1, -2, -3), (2, 3, 4)]
            token visibility = "invisible"

            def Mesh "Pruned"
            {
                float3[] extent = [(-1, -2, -3), (2, 3, 4)]
                uniform token purpose = "proxy"
            }
        }

        def Xform "Proxy"
        {
            uniform token purpose = "proxy"
            float xformOp:rotateZ = 0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Mesh "C"
            {
                float3[] extent = [(-1, -2, -3), (2, 3, 4)]
            }
        }

        def Xform "Sub" (
            kind = "subcomponent"
        )
        {
            float xformOp:rotateZ = 44
            double3 xformOp:translate = (1, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Mesh "D"
            {
                float3[] extent = [(-1, -2, -3), (2, 3, 4)]
                uniform token purpose = "guide"
            }
        }
    }

    def Xform "Unmodelled"
    {
        float xformOp:rotateZ = 37
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Mesh "E"
        {
            float3[] extent = [(-1, -2, -3), (2, 3, 4)]
        }
    }

    def Xform "Hint" (
        kind = "component"
    )
    {
        custom float3[] extentsHint = [(-10, -1, -1), (10, 1, 1), (-20, -2, -2), (20, 2, 2), (1, 1, 1), (-1, -1, -1), (-40, -4, -4), (40, 4, 4)]
        float xformOp:rotateZ = 11
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Mesh "Child"
        {
            float3[] extent = [(-1, -2, -3), (2, 3, 4)]
        }
    }

    def FutureSchema "Unknown"
    {
        def Mesh "Child"
        {
            float3[] extent = [(-1, -2, -3), (2, 3, 4)]
        }
    }

    def Material "Typed"
    {
        def Mesh "Child"
        {
            float3[] extent = [(-1, -2, -3), (2, 3, 4)]
        }
    }

    class Mesh "Class"
    {
        float3[] extent = [(-1, -2, -3), (2, 3, 4)]
    }

    def Mesh "Boundable"
    {
        float3[] extent = [(-1, -2, -3), (2, 3, 4)]

        def Mesh "Child"
        {
            float3[] extent = [(-100, -100, -100), (100, 100, 100)]
        }
    }

    def "I1" (
        instanceable = true
        prepend references = </Prototype>
    )
    {
        uniform token purpose = "render"
    }

    def "I2" (
        instanceable = true
        prepend references = </Prototype>
    )
    {
        uniform token purpose = "proxy"
    }
}

def Xform "Isolated"
{
    float xformOp:rotateZ = 0
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

    def Material "Typed"
    {
        def Mesh "Child"
        {
            float3[] extent = [(10, 20, 30), (40, 50, 60)]
        }
    }
}

def Xform "Prototype"
{
    float xformOp:rotateZ = 0
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

    def Mesh "Leaf"
    {
        float3[] extent = [(-1, -2, -3), (2, 3, 4)]
    }
}

over Xform "Undefined"
{
    float xformOp:rotateZ = 0
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

    def Xform "Middle"
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Mesh "Leaf"
        {
            float3[] extent = [(-1, -2, -3), (2, 3, 4)]
        }
    }
}

class Xform "Abstract"
{
    float xformOp:rotateZ = 0
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

    def Xform "Middle"
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Mesh "Leaf"
        {
            float3[] extent = [(-1, -2, -3), (2, 3, 4)]
        }
    }
}
