#usda 1.0

def "Press" (
    prepend references = @./clay.usda@</Slip>
    variantSets = "grip"
    variants = {
        string grip = "firm"
    }
)
{
    variantSet "grip" = {
        "firm" (
            prepend references = @./clay.usda@</Slip>
            prepend inherits = </_class_Press>
            prepend payload = @./clay.usda@</Ash>
        ) {
        }
    }
}

class "_class_Press"
{
    double press = 1
}
