def Shader "Outside"
{
    float inputs:in
    float outputs:out
}
def ProbeContainer "Chain"
{
    float inputs:in.connect = </Outside.outputs:out>

    def Shader "Inner"
    {
        float inputs:x.connect = </Chain.inputs:in>
    }
}

def Xform "AppliedChain" (
    prepend apiSchemas = ["ProbeContainerAPI"]
)
{
    float inputs:in.connect = </Outside.outputs:out>

    def Shader "Inner"
    {
        float inputs:x.connect = </AppliedChain.inputs:in>
    }
}

def ProbePlain "Stop"
{
    float inputs:in.connect = </Outside.outputs:out>

    def Shader "Inner"
    {
        float inputs:x.connect = </Stop.inputs:in>
    }
}
