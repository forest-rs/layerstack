#usda 1.0

def Material "Mat"
{
    def Shader "Source"
    {
        float inputs:a:b
        float inputs:in
        float outputs:defined
        rel outputs:rel
    }

    over "Over"
    {
    }

    def "Inactive" (
        active = false
    )
    {
        def Shader "Kid"
        {
            float outputs:out
        }
    }

    def Shader "Lamp" (
        variants = {
            string shade = "warm"
        }
        prepend variantSets = "shade"
    )
    {
        variantSet "shade" = {
            "warm" {
                color3f outputs:glow
            }
        }
    }
}

def Xform "Robot" (
    instanceable = true
    prepend references = </RobotPrototype>
)
{
}

def Xform "RobotPrototype"
{
    def Shader "Eye"
    {
        float outputs:out
    }
}
