def Scope "Lights"
{
    def Xform "Sun" (
        prepend apiSchemas = ["CollectionAPI:lightLink", "CollectionAPI:shadowLink"]
    )
    {
        rel collection:lightLink:excludes = [
            </Terrain/Rock_03>,
            </Terrain/Pebble>,
            </Terrain/Retired>,
        ]
        rel collection:lightLink:includes = [
            </Terrain>,
            </Terrain/Boulder>,
            </Terrain/Rock_00.weight>,
            </Terrain/Retired/Rock_01>,
            </Terrain/Quarry/Stone_00>,
            </Plants/Fern_00/Frond>,
        ]
        rel collection:shadowLink:includes = [
            </Lights/Fill.collection:lightLink>,
            </Lights/Fill.collection:glare>,
            </Gone.collection:lightLink>,
        ]
    }

    def Xform "Fill" (
        prepend apiSchemas = ["CollectionAPI:lightLink"]
    )
    {
        rel collection:lightLink:excludes = </Placements/Spot_99>
        rel collection:lightLink:includes = </Placements>
    }
}

def Scope "Sets" (
    prepend apiSchemas = ["CollectionAPI:rocks", "CollectionAPI:plants", "CollectionAPI:shallow"]
)
{
    uniform token collection:plants:expansionRule = "expandPrimsAndProperties"
    rel collection:plants:includes = [
        </Plants/Fern_00>,
        </Plants/Fern_01/Frond.width>,
        </Plants/Fern_02/Frond.height>,
    ]
    rel collection:rocks:excludes = </Terrain/Retired/Rock_02>
    rel collection:rocks:includes = [
        </Terrain/Rock_00>,
        </Terrain/Rock_01>,
        </Terrain/Rock_02>,
        </Terrain/Rock_03>,
        </Terrain/Rock_04>,
        </Terrain/Rock_05>,
        </Terrain/Rock_06>,
        </Terrain/Rock_07>,
        </Terrain/Rock_08>,
        </Terrain/Rock_09>,
        </Terrain/Rock_10>,
        </Terrain/Rock_11>,
        </Terrain/Rock_12>,
        </Terrain/Rock_13>,
        </Terrain/Rock_14>,
        </Terrain/Rock_15>,
        </Terrain/Rock_16>,
        </Terrain/Rock_17>,
        </Terrain/Rock_18>,
        </Terrain/Rock_19>,
        </Terrain/Rock_20>,
        </Terrain/Rock_21>
    ]
    uniform pathExpression collection:shallow:membershipExpression = "/Terrain/Rock_0*"
}

