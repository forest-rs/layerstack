#usda 1.0
(
    defaultPrim = "Glade"
    expressionVariables = {
        string SEASON = "winter"
    }
)

def "Glade" (
    variants = {
        string season = "`'${SEASON}'`"
    }
    variantSets = "season"
)
{
    variantSet "season" = {
        "summer" {
            int bloom = 3
        }
        "winter" {
            int bloom = 0
        }
    }
}
