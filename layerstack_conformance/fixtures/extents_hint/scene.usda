#usda 1.0

def Xform "Asset" (
    kind = "component"
)
{
    double3 xformOp:translate = (10, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Mesh "Body"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (2, 0, 0), (0, 3, 0)]
        point3f[] points.timeSamples = {
            1: [(0, 0, 0), (4, 0, 0), (0, 5, 1)],
        }
    }

    def Cube "Hero"
    {
        double size = 1
        uniform token purpose = "render"
        double3 xformOp:translate = (0, 0, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Stand"
    {
        uniform token purpose = "proxy"
        double radius = 2
    }
}

def Xform "OnlyDefault" (
    kind = "component"
)
{
    def Sphere "Ball"
    {
        double radius = 0.5
    }
}

def Xform "GuideOnly" (
    kind = "component"
)
{
    def Cube "Marker"
    {
        uniform token purpose = "guide"
    }
}

def Xform "Bare" (
    kind = "component"
)
{
}

def Mesh "Shell" (
    kind = "component"
)
{
    float3[] extent = [(-9, -9, -9), (9, 9, 9)]
    int[] faceVertexCounts = [3]
    int[] faceVertexIndices = [0, 1, 2]
    point3f[] points = [(1, 1, 1), (2, 1, 1), (1, 3, 2)]
}

def Mesh "Pointless" (
    kind = "component"
)
{
}

def PointInstancer "Scatter" (
    kind = "component"
)
{
    point3f[] positions = [(0, 0, 0), (5, 0, 0)]
    int[] protoIndices = [0, 0]
    rel prototypes = </Scatter/Protos/Pebble>

    def Scope "Protos"
    {
        def Sphere "Pebble"
        {
            double radius = 1
        }
    }
}

def Xform "Hinted" (
    kind = "component"
)
{
    float3[] extentsHint = [(-1, -1, -1), (1, 1, 1)]

    def Cube "Box"
    {
        double size = 4
    }
}

def Xform "Group" (
    kind = "assembly"
)
{
    def Xform "Left" (
        kind = "component"
    )
    {
        double3 xformOp:translate = (-5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Box"
        {
        }
    }

    def Xform "Right" (
        kind = "component"
    )
    {
        float3 xformOp:rotateXYZ = (0, 0, 45)
        double3 xformOp:translate = (5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

        def Cube "Box"
        {
            uniform token purpose = "render"
        }
    }
}
