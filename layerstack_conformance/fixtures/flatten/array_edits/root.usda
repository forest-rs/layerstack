#usda 1.0
(
    defaultPrim = "Hedge"
)

# Time samples composed from sparse array edits are written as the dense
# arrays they compose to at each sample time.
def Xform "Hedge" (
    references = @./shrub.usda@ (offset = 2)
)
{
    # Edits over the asset's samples, which are read two frames later.
    int[] leafIds.timeSamples = {
        0: edit [write 9 to [0]],
        6: edit [append 7],
    }
    # A sparse default over the asset's samples.
    float[] widths = edit [prepend 0.5]
    # Edits over nothing: they apply to an empty array.
    int[] buds.timeSamples = {
        1: edit [append 3],
    }
    # Edits over a default block: they apply to an empty array.
    int[] thorns.timeSamples = {
        1: edit [append 4],
    }
    # Edits over a `timecode` default read through the offset: 4 is 6.
    timecode[] cues.timeSamples = {
        1: edit [append 20],
    }
    # Edits over edits over a dense default.
    int[] rings.timeSamples = {
        3: edit [append 30],
    }
}
