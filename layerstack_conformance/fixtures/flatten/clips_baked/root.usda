#usda 1.0
(defaultPrim = "World")
def "World" (
    clips = { dictionary default = {
        asset[] assetPaths = [@a.usda@, @b.usda@]
        string primPath = "/Clip"
        double2[] active = [(0,0), (10,1)]
        double2[] times = [(0,0), (10,10), (10,0), (20,10)]
    }}
) {
    double x
    timecode clock
    asset texture
    int[] ids = edit [write 99 to [0]]
    def "Child" {
        double x
    }
}
