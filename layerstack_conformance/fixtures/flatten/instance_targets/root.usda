#usda 1.0
(
    defaultPrim = "Grove"
)

# Targets inside instances map onto the prototype however the prototype's
# prims are ordered: a target to a sibling copied later, and one to a prim
# that does not exist.
def Xform "Grove"
{
    def "First" (
        instanceable = true
        references = @./hedge.usda@
    )
    {
    }

    def "Second" (
        instanceable = true
        references = @./hedge.usda@
    )
    {
    }
}
