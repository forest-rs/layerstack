#usda 1.0
(
    defaultPrim = "Hedge"
)

# Value clips, which composition does not read, so a flattened layer cannot
# hold the values they supply.
def Xform "Hedge" (
    clips = {
        dictionary default = {
            asset[] assetPaths = [@./clip.usda@]
            string primPath = "/Shrub"
        }
    }
)
{
    int[] leafIds = [1, 2, 3]
}
