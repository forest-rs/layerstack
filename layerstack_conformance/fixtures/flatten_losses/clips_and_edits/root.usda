#usda 1.0
(
    defaultPrim = "Hedge"
)

# What a flattened layer cannot hold yet: value clips, and time samples
# composed from sparse array edits over a referenced asset's arrays.
def Xform "Hedge" (
    references = @./shrub.usda@
    clips = {
        dictionary default = {
            asset[] assetPaths = [@./clip.usda@]
            string primPath = "/Shrub"
        }
    }
)
{
    int[] leafIds.timeSamples = {
        0: edit [write 9 to [0]],
        4: edit [append 7],
    }
}
