def Cube "CubeAuthored"
{
    float3[] extent = [(-8, -9, -10), (8, 9, 10)]
    double size = 12
}

def Cube "CubeMalformed"
{
    float3[] extent = [(1, 2, 3)]
    double size = 12
}

def Cube "CubeBlocked"
{
    float3[] extent = None
    double size = 12
}

def Cube "CubeChangingExtent"
{
    float3[] extent.timeSamples = {
        0: None,
        2: [(-2, -3, -4), (2, 3, 4)],
    }
    double size = 12
}

def Cylinder "CylinderChangingAxis"
{
    uniform token axis.timeSamples = {
        0: "X",
        2: "Y",
    }
    double height = 8
}

def Mesh "Mesh"
{
    point3f[] points = [(-3, 2, -1), (4, -5, 6), (1, 2, 3)]
}

def Mesh "EmptyMesh"
{
    point3f[] points = []
}

def Mesh "AnimatedMesh"
{
    point3f[] points = [(-1, -2, -3), (1, 2, 3)]
    point3f[] points.timeSamples = {
        0: [(-2, -3, -4), (2, 3, 4)],
        2: [(-4, -5, -6), (4, 5, 6)],
    }
}

