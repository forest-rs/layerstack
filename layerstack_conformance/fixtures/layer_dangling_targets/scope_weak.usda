#usda 1.0
(
    doc = """The weaker scope: paths the stronger scope deletes or keeps."""
)

over "World"
{
    over "Bed_A"
    {
        append rel shade = [</World/Bed_A/Soil>, </World/Lost>]
    }
}

def Xform "Path_1"
{
    append rel shade = [</World/Lost>, </World/Bed_A>, </World/Shed/Soil>]
    float input = 0
    append float input.connect = </World/Bed_B/Soil.moisture>
}

over "Lights"
{
    append rel collection:lit:includes = [</World/Bed_B>, </World/Gone_weak>]
}
