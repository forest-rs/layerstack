#usda 1.0
(
    subLayers = [@weak.usda@ (offset = 10; scale = 2)]
    documentation = "strong layer metadata"
    startTimeCode = 5
    endTimeCode = 8
)
over "P" (
    customData = { dictionary nested = { int strong = 1 } }
    delete references = @assets/deleted.usda@</Asset>
    prepend payload = @assets/payload.usda@</Asset>
    variants = { string look = "red" }
) {
    double masked = 4
    double animated.timeSamples = { 1: 9 }
    variantSet "look" = {
        "red" {
            string label = "strong red"
        }
    }
}
class "Class" {
            double inherited = 7
        }
class "Specialized" {
            double specialized = 8
        }
