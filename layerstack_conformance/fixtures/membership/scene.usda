#usda 1.0
(
    doc = "Reverse collection membership for tests/membership_index.rs; scripts/binding_oracle.py records what OpenUSD computes."
    subLayers = [
        @strong.usda@,
        @weak.usda@
    ]
)

over "Parts" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding:collection:heavy = [</Parts.collection:heavy>, </Looks/Stone>]
    rel material:binding:collection:stones = [</Sets.collection:stones>, </Looks/Moss>] (
        bindMaterialAs = "strongerThanDescendants"
    )
}

def Scope "Looks"
{
    def Material "Stone"
    {
    }

    def Material "Moss"
    {
    }
}
