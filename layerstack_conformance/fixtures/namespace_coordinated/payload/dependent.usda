#usda 1.0

def "Use" (
    prepend references = @root.usda@</Model>
)
{
    over "Child"
    {
        custom double size = 3
    }
}

def "Watch"
{
    custom pathExpression expression = "/Use/Child//"
    custom double inputs:value
    double inputs:value.connect = </Use/Child.size>
    custom rel look = </Use/Child>
}
