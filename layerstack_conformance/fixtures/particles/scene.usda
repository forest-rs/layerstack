#usda 1.0

def ParticleField3DGaussianSplat "Missing" {

}

def ParticleField3DGaussianSplat "Half" {
    point3h[] positionsh = [(1, 2, 3)]
    quath[] orientationsh = [(1, 0, 0, 0)]
    half3[] scalesh = [(1, 2, 3)]
    half[] opacitiesh = [0.5]
    half3[] radiance:sphericalHarmonicsCoefficientsh = [(1, 2, 3)]
}

def ParticleField3DGaussianSplat "Float" {
    point3f[] positions = [(1, 2, 3)]
    quatf[] orientations = [(1, 0, 0, 0)]
    float3[] scales = [(1, 2, 3)]
    float[] opacities = [0.5]
    float3[] radiance:sphericalHarmonicsCoefficients = [(1, 2, 3)]
}

