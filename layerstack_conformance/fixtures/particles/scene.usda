def ParticleField3DGaussianSplat "EmptyFirst" {
    point3h[] positionsh = [(1, 2, 3)]
    point3f[] positions.timeSamples = { -2: [], 3: [(1, 2, 3)] }
    quath[] orientationsh = [(1, 0, 0, 0)]
    quatf[] orientations.timeSamples = { -2: [], 3: [(1, 0, 0, 0)] }
    half3[] scalesh = [(1, 2, 3)]
    float3[] scales.timeSamples = { -2: [], 3: [(1, 2, 3)] }
    half[] opacitiesh = [0.5]
    float[] opacities.timeSamples = { -2: [], 3: [0.5] }
    half3[] radiance:sphericalHarmonicsCoefficientsh = [(1, 2, 3)]
    float3[] radiance:sphericalHarmonicsCoefficients.timeSamples = { -2: [], 3: [(1, 2, 3)] }
}

def ParticleField3DGaussianSplat "FullFirst" {
    point3f[] positions.timeSamples = { -2: [(1, 2, 3)], 3: [] }
    quatf[] orientations.timeSamples = { -2: [(1, 0, 0, 0)], 3: [] }
    float3[] scales.timeSamples = { -2: [(1, 2, 3)], 3: [] }
    float[] opacities.timeSamples = { -2: [0.5], 3: [] }
    float3[] radiance:sphericalHarmonicsCoefficients.timeSamples = { -2: [(1, 2, 3)], 3: [] }
}

def ParticleField3DGaussianSplat "DefaultAndEmptyFirst" {
    point3f[] positions = [(1, 2, 3)]
