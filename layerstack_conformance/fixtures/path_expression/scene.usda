#usda 1.0
(
    doc = "Path expressions and collection predicates for tests/path_expression.rs; scripts/path_expression_oracle.py records what OpenUSD matches."
    subLayers = [
        @weak.usda@
    ]
)
def Xform "World" (
    kind = "assembly"
    prepend apiSchemas = ["CollectionAPI:tagged"]
    variants = {
        string shade = "blue"
        string size = "big-1"
    }
    prepend variantSets = ["shade", "size", "lod"]
)
{
    double size = 1
    custom float points:x = 2
    pathExpression collection:tagged:membershipExpression = "//Rock"

    def Mesh "Rock" (
        kind = "component"
    )
    {
        double size = 2
        custom float points:y = 3
    }

    def Gprim "Abstracted"
    {
    }

    def Unregistered "Unknown" (
        kind = "bogus"
    )
    {
    }

    def Xform "Group" (
        kind = "group"
    )
    {
        def Xform "Part" (
            kind = "component"
        )
        {
            double size = 3

            def Xform "Detail" (
                kind = "subcomponent"
            )
            {
            }

            def Xform "Inner" (
                kind = "component"
            )
            {
            }
        }

        def Scope "Modeled" (
            kind = "model"
        )
        {
        }
    }

    def Xform "Loose" (
        prepend apiSchemas = ["CollectionAPI:applied"]
    )
    {
        pathExpression collection:unapplied:membershipExpression = "/World"

        def Xform "Part" (
            kind = "component"
        )
        {
        }
    }

    class "Template"
    {
        def Xform "InTemplate"
        {
            double size = 4
        }
    }

    over "Sketch"
    {
        def Xform "UnderSketch"
        {
        }
    }

    def Xform "Tagged" (
        prepend apiSchemas = ["CollectionAPI:a", "CollectionAPI:b", "MaterialBindingAPI"]
    )
    {
    }

    def Sphere "Ball"
    {
    }
    variantSet "shade" = {
        "blue" {
        }
        "red" {
        }
    }
    variantSet "size" = {
        "big-1" {
        }
    }
}

def Xform "Fallback" (
    variants = {
        string lod = "missing"
    }
    prepend variantSets = "lod"
)
{
    variantSet "lod" = {
        "high" {
        }
    }
}

def Xform "Nested" (
    variants = {
        string outer = "on"
    }
    prepend variantSets = "outer"
)
{
    variantSet "outer" = {
        "off" (
            variants = {
                string shape = "round"
            }
            prepend variantSets = "shape"
        ) {
            variantSet "shape" = {
                "round" {
                }
            }
        }
        "on" (
            variants = {
                string color = "red"
            }
            prepend variantSets = "color"
        ) {
            variantSet "color" = {
                "red" (
                    variants = {
                        string depth = "deep"
                    }
                    prepend variantSets = "depth"
                ) {
                    variantSet "depth" = {
                        "deep" {
                        }
                    }
                }
            }
        }
    }
}

def Xform "Undeclared" (
    variants = {
        string undeclared = "chosen"
    }
)
{
}

def Xform "Other"
{
    def Xform "Rock"
    {
    }
}

def Xform "Referencing" (
    prepend references = @asset.usda@</Asset>
    variants = {
        string mode = "plain"
    }
)
{
    pathExpression collection:kit:membershipExpression = "%_ - Part/Hidden"
}
