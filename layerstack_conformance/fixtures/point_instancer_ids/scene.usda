#usda 1.0
(
    defaultPrim = "Legacy"
)

def PointInstancer "Legacy" (
    add inactiveIds = [30, 10]
    delete inactiveIds = [20]
)
{
    int64[] ids = [10, 20, 30, 40, 50, 60, 90, 99]
    int[] protoIndices = [0, 0, 0, 0, 0, 0, 0, 0]
}

def PointInstancer "Explicit" (
    inactiveIds = [30, 10]
)
{
    int64[] ids = [10, 20, 30, 40, 50, 60]
    int[] protoIndices = [0, 0, 0, 0, 0, 0]
}

def PointInstancer "Sparse" (
    prepend inactiveIds = [4]
    append inactiveIds = [3, 0]
    delete inactiveIds = [1]
)
{
    int[] protoIndices = [0, 0, 0, 0, 0, 0]
}

def PointInstancer "Sampled"
{
    int64[] ids = [1, 3, 5, 6, 7, 8, 9, 20, 40]
    int64[] invisibleIds = [7, 7, 3]
    int64[] invisibleIds.timeSamples = {
        1: [5],
        2: [5, 6],
    }
    int[] protoIndices = [0, 0, 0, 0, 0, 0, 0, 0, 0]
}

def PointInstancer "Unauthored"
{
    int[] protoIndices = [0, 0, 0, 0]
}
