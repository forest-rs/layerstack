#usda 1.0
(
    subLayers = [
        @weak.usda@
    ]
)
# Copyright 2026 the LayerStack Authors
# SPDX-License-Identifier: Apache-2.0 OR MIT

def Xform "World"
{
    def Xform "Rock"
    {
        double3 xformOp:translate = (1, 2, 3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Lamp"
    {
    }
}

def Xform "Sky"
{
}

def Xform "Robot" (
    instanceable = true
    prepend references = @asset.usda@</Asset>
)
{
}

def Xform "Drone" (
    instanceable = true
    prepend references = @asset.usda@</Asset>
)
{
}

def Xform "Thing" (
    prepend references = @asset.usda@</Asset>
)
{
}

def Xform "Switch" (
    variants = {
        string look = "day"
    }
    prepend variantSets = "look"
)
{
    variantSet "look" = {
        "day" {
            def Xform "Sun"
            {
            }
        }
        "night" {
            def Xform "Star"
            {
            }
        }
    }
}

def Xform "Rover"
{
}

def Xform "Echo" (
    inherits = </World/Lamp>
)
{
}
