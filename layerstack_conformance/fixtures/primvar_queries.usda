#usda 1.0
# ID targets and value/index animation; native OpenUSD 26.8 oracle.
def "Root" {
    float primvars:tint = 0.5
    float primvars:barrier = 1
    def "Group" {
        float primvars:tint = None
        float primvars:barrier = 2 (interpolation = "vertex")
        float primvars:local = 3
        def Mesh "Mesh" {
            string primvars:id = "ignored"
            rel primvars:id:idFrom = </Root.MeshForward>
            string primvars:emptyId = "ignored"
            rel primvars:emptyId:idFrom = []
            string primvars:manyId = "ignored"
            rel primvars:manyId:idFrom = [</A>, </B>]
            string[] primvars:ids = ["ignored"]
            rel primvars:ids:idFrom = [</A>, </B>]
            string[] primvars:oneId = ["ignored"]
            rel primvars:oneId:idFrom = </A>
            float primvars:notString = 4
            rel primvars:notString:idFrom = </A>
            string primvars:notRel = "local"
            string primvars:notRel:idFrom = "attribute"
            float[] primvars:indexOnly = [10, 20]
            int[] primvars:indexOnly:indices.timeSamples = {1: [0], 2: [1]}
            float[] primvars:both.timeSamples = {1: [3, 4], 2: [5, 6]}
            int[] primvars:both:indices.timeSamples = {0: [0], 3: [1]}
            float[] primvars:blockedIndices = [10, 20]
            int[] primvars:blockedIndices:indices = None
            float[] primvars:single = [10, 20]
            int[] primvars:single:indices.timeSamples = {1: [0]}
            float[] primvars:noIndices = [1, 2]
            float[] primvars:badSidecar = [1]
            rel primvars:badSidecar:indices = </A>
            float primvars:unvalued
            float primvars:blocked = None
            def "Child" {}
        }
        def "Sibling" {}
    }
    rel MeshForward = </Missing.property>
}
