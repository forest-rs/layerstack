def Xform "Rock"
{
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Xform "Lamp" (
    prepend references = @asset.usda@</Asset>
)
{
}

def Xform "Robot" (
    instanceable = true
    prepend references = @asset.usda@</Asset>
)
{
}

def Scope "Looks"
{
}
