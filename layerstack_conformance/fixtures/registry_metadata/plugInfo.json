      "metaFloats": { "type": "float[]", "appliesTo": "variants", "default": [0.5, 1.5] },
      "metaTokens": { "type": "token[]", "appliesTo": "prims", "default": ["a", "b"] },
      "metaStrings": { "type": "string[]", "appliesTo": "prims" },
