      "metaHalf": { "type": "half", "appliesTo": "attributes", "default": 0.5 },
      "metaFloat": { "type": "float", "appliesTo": "prims", "default": 0.25, "displayGroup": "Shape" },
      "metaDouble": { "type": "double", "appliesTo": "layers", "default": 2 },
      "metaTimeCode": { "type": "timecode", "appliesTo": "prims", "default": 12 },
