      "metaIntList": { "type": "intlistop", "appliesTo": "prims" },
      "metaUIntList": { "type": "uintlistop", "appliesTo": "prims" },
      "metaInt64List": { "type": "int64listop", "appliesTo": "prims" },
      "metaUInt64List": { "type": "uint64listop", "appliesTo": "prims" },
      "metaAnywhere": { "type": "token", "documentation": "On every kind of spec." },
      "metaVariantOnly": { "type": "int", "appliesTo": ["variants"] },
      "metaNowhere": { "type": "int", "appliesTo": ["nodes"] },
      "metaLoose": { "type": "int", "appliesTo": 3 }
    }}
