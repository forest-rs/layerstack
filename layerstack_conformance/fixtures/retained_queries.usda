def Xform "World" {
    double3 xformOp:translate = (0, 0, 0)
    double3 xformOp:translate.timeSamples = { 0: (0, 0, 0), 2: (2, 0, 0) }
    uniform token[] xformOpOrder = ["xformOp:translate"]
    double inputs:unrelated = 1
    def Cube "Shape" {
        double size = 2
    }
    def Xform "Reset" {
        uniform token[] xformOpOrder = ["!resetXformStack!"]
        def Cube "Shape" {
            double size = 2
        }
    }
}
def Material "Material" {
    float inputs:a = 0.25
    float inputs:a.timeSamples = { 0: 0.25, 2: 0.75 }
    float inputs:b = 0.25
    def Shader "Surface" {
        float inputs:roughness.connect = </Material.inputs:a>
    }
}
