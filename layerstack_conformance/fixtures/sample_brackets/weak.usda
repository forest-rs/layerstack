#usda 1.0

over "Blocked"
{
    double a.timeSamples = {
        1: 1,
        2: 2,
    }
}

over "AnimBlocked"
{
    double a.timeSamples = {
        1: 1,
        2: 2,
    }
}

over "Empty"
{
    double a.timeSamples = {
