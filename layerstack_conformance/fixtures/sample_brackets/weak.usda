        2: 2,
    }
}

over "Sparse"
{
    int[] e.timeSamples = {
        1: [1],
        6: [6],
    }
}

over "Mixed"
{
    int[] e.timeSamples = {
        1: [1],
        3: [3],
        8: [8],
    }
}

over "SparseDefault"
{
    int[] e.timeSamples = {
        1: [1],
        3: [3],
    }
}

over "SparseOverBlock"
{
    int[] e = None
}
