#usda 1.0
(
    """Lab bench schemas, which build on OpenUSD's `Xformable`: a codeless
    library compiled against OpenUSD's own schema sources."""
    subLayers = [
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "labBenches"
        string libraryPath = "."
        bool skipCodeGeneration = true
    }
)
{
}

class Bench "Bench" (
    inherits = </Xformable>
    doc = "A lab bench, placed in the room."
    prepend apiSchemas = ["VisibilityAPI"]
)
{
    float bench:height = 0.9 (
        doc = "Work surface height, in meters."
    )
    uniform token bench:surface = "epoxy" (
        allowedTokens = ["epoxy", "steel", "wood"]
    )
}

class "BenchMountAPI" (
    inherits = </APISchemaBase>
    doc = "What an instrument is mounted on."
    customData = {
        token apiSchemaType = "singleApply"
        token[] apiSchemaCanOnlyApplyTo = ["Xformable"]
    }
)
{
    rel mount:bench (
        doc = "The bench."
    )
}
