#usda 1.0

def Scope "Fallback_CollectionAPI" (
    prepend apiSchemas = ["CollectionAPI:a"]
)
{
}

def Scope "Authored_CollectionAPI" (
    prepend apiSchemas = ["CollectionAPI:a"]
)
{
    rel collection:a:excludes = </Target>
    uniform token collection:a:expansionRule = "expandPrims"
    uniform bool collection:a:includeRoot = true
    rel collection:a:includes = </Target>
    uniform token collection:a:mode = "relationship"
}

