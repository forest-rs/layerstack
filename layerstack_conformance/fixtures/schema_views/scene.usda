def Scope "Authored_BackPlateAPI" (
    prepend apiSchemas = ["BackPlateAPI:a"]
)
{
    asset backPlate:a:alpha:image = @asset1.usda@
    asset backPlate:a:alpha:image.timeSamples = {
        2: @asset2.usda@,
    }
    float backPlate:a:depth:cameraSpaceOffset = 1.5
    float backPlate:a:depth:cameraSpaceOffset.timeSamples = {
        2: 2.5,
    }
    asset backPlate:a:depth:image = @asset1.usda@
    asset backPlate:a:depth:image.timeSamples = {
        2: @asset2.usda@,
    }
    float backPlate:a:depth:minOffset = 1.5
    float backPlate:a:depth:minOffset.timeSamples = {
        2: 2.5,
    }
    float backPlate:a:depth:normalizingFactor = 1.5
    float backPlate:a:depth:normalizingFactor.timeSamples = {
        2: 2.5,
    }
    asset backPlate:a:image = @asset1.usda@
    asset backPlate:a:image.timeSamples = {
        2: @asset2.usda@,
    }
    float3 backPlate:a:luma:gain = (1.5, 2.5, 3.5)
    float3 backPlate:a:luma:gain.timeSamples = {
        2: (2.5, 3.5, 4.5),
    }
    float3 backPlate:a:luma:gamma = (1.5, 2.5, 3.5)
    float3 backPlate:a:luma:gamma.timeSamples = {
        2: (2.5, 3.5, 4.5),
    }
    float3 backPlate:a:luma:lift = (1.5, 2.5, 3.5)
    float3 backPlate:a:luma:lift.timeSamples = {
        2: (2.5, 3.5, 4.5),
    }
    token backPlate:a:plateVisibility = "solo"
    token backPlate:a:plateVisibility.timeSamples = {
        2: "mute",
    }
    float3 backPlate:a:rotateXYZ:tweak = (1.5, 2.5, 3.5)
    float3 backPlate:a:rotateXYZ:tweak.timeSamples = {
        2: (2.5, 3.5, 4.5),
    }
    float2 backPlate:a:scale:tweak = (1.5, 2.5)
    float2 backPlate:a:scale:tweak.timeSamples = {
        2: (2.5, 3.5),
    }
    float3 backPlate:a:translate:tweak = (1.5, 2.5, 3.5)
    float3 backPlate:a:translate:tweak.timeSamples = {
        2: (2.5, 3.5, 4.5),
    }
}

