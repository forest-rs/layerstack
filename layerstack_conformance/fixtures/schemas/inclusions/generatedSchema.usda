(
    "Test schemas for layerstack's prim definition oracle; written as usdGenSchema writes generatedSchema.usda."
)

class "FooBar"
{
    half foobarprop = 0.5
}

class "BarBaz"
{
    string __INSTANCE_NAME__:barbazprop = ""
}

