#usda 1.0

def Shader "Asset"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform token info:id = "UsdPreviewSurface"
    uniform asset info:osl:sourceAsset = @a.osl@
    uniform asset info:sourceAsset = @u.osl@
    uniform token info:sourceAsset:subIdentifier = "Universal"
    uniform asset info:mdl:sourceAsset
    uniform token info:mdl:sourceAsset:subIdentifier = "Local"
}

def Shader "Code"
{
    uniform token info:implementationSource = "sourceCode"
    uniform string info:glslfx:sourceCode = "void main() {}"
    uniform string info:sourceCode = "universal"
    uniform asset info:osl:sourceAsset = @ignored.osl@
}

def Shader "Unknown"
{
    uniform token info:implementationSource = "bogus"
    uniform token info:id = "UsdPreviewSurface"
    uniform asset info:osl:sourceAsset = @ignored.osl@
}

def Shader "Plain"
{
    uniform token info:id = "UsdPreviewSurface"
}

def PluginLight "Light"
{
    uniform token info:id = "CustomLight"
}
