#usda 1.2
(subLayers = [@weak.usda@ (offset = 5; scale = 2)])
over "Skip"
{
    double inputs:intensity = 2
}

over "Fallback"
{
    double inputs:intensity = 2
}

over "Compatible"
{
    float inputs:intensity = 7
}

over "Block"
{
    float inputs:intensity = None
}

over "BelowBlock"
{
    double inputs:intensity = 2
}

over "Samples"
{
    double inputs:intensity = 2
}

over "Vector"
{
    double3 value = (8, 9, 10)
}

over "Array"
{
    double3[] value = [(8, 9, 10)]
}

over "Matrix"
{
    float value = 5
}

over "Time"
{
    float value = 5
}

over "Asset"
{
    string value = "wrong"
}

over "Expression"
{
    string value = "wrong"
}
over "NoDefault"
{
    double inputs:intensity.timeSamples = {1: 20, 3: 30}
}
over "NoCompatible"
{
    double value = 2
}
over "WrongExpression"
{
    pathExpression value = "/World//"
}

over "WrongDictionary"
{
    float value = 2
}

over "WrongEdit"
{
    float[] value = edit [append 4]
}

over "ExpressionBelow"
{
    float value = 2
}

over "MisdeclaredTime"
{
    float value = 5
}
over "SparseCompatibleBase"
{
    float[] value = edit [append 4]
}

over "SparseSampledBase"
{
    float[] value = edit [append 4]
    float[] value.timeSamples = { 0: edit [append 4], 10: edit [append 8] }
}
over "SparseScalarBase"
{
    float[] value = edit [append 4]
}
over "SparseWrongDense"
{
    double[] value = [2]
}

over "SparseWrongLower"
{
    float[] value = edit [append 4]
    float[] value.timeSamples = { 0: edit [append 4], 10: edit [append 8] }
}
over "SparseWrongUpper"
{
    float[] value = edit [append 4]
    float[] value.timeSamples = { 0: edit [append 4], 10: edit [append 8] }
}

over "SparseResizeKind"
{
    float[] value = edit [resize 1]
}
over "SparseDeleteKind"
{
    float[] value = edit [erase [0]]
}

over "SparseFillDeclaration"
{
    double[] value = [2]
}
over "SparseMixedEdits"
{
    float[] value = edit [resize 2]
}

over "SparseMisdeclaredEdit"
{
    float[] value = edit [resize 2]
}
over "SparseMisdeclaredWeakEdit"
{
    float[] value = edit [resize 2]
}

over "SparseDeclaration"
{
    float[] value
}
over "SparseConnection"
{
    float[] value.connect = </Compatible.inputs:intensity>
}
over "SparseContribution"
{
    float[] value = edit [append 4]
}

over "SparseWrongEditUpper"
{
    float[] value = edit [append 4]
    float[] value.timeSamples = { 0: edit [append 4], 50: edit [append 8] }
}

over "SparseEmptySamples"
{
    float[] value = [9]
    float[] value.timeSamples = {}
}
over "SparseEmptyDeclaration"
{
    float[] value.timeSamples = {}
}

over "EmptySamplesXform"
{
    float3 xformOp:translate.timeSamples = {}
}
