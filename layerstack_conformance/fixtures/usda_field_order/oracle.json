   "text": "#usda 1.0\n\ndef Mesh \"Q\"\n{\n    custom float inputs:a\n    custom float inputs:b\n    float inputs:b.connect = [\n        </Q.size>,\n        </Q.inputs:a>,\n    ]\n    texCoord2f[] primvars:st = [(0, 0), (1, 0)] (\n        \"first\"\n        customData = {\n            int a = 2\n            int z = 1\n        }\n        displayName = \"UV\"\n        doc = \"texture coordinates\"\n        elementSize = 1\n        hidden = true\n        interpolation = \"vertex\"\n    )\n    custom rel rel = [\n        </Q>,\n        </Q.size>,\n        </Q.inputs:a>,\n    ] (\n        customData = {\n            int k = 1\n        }\n        doc = \"r\"\n    )\n    uniform float size = 2\n    uniform float size.timeSamples = {\n        -1: 1,\n        2.5: 4,\n        10: 3,\n    }\n}\n\n"
