   "text": "#usda 1.0\n\nclass \"C\"\n{\n}\n\ndef \"S\"\n{\n}\n\ndef Xform \"P\" (\n    \"a note\"\n    active = true\n    prepend apiSchemas = [\"MaterialBindingAPI\", \"CollectionAPI:a\"]\n    customData = {\n        string Ab = \"x\"\n        int _x = 2\n        double aa = 0.5\n        int b10 = 3\n        int b9 = 4\n        dictionary nested = {\n            int x = 2\n            int y = 1\n        }\n        int zz = 1\n    }\n    displayName = \"P\"\n    doc = \"d\"\n    hidden = true\n    prepend inherits = </C>\n    instanceable = false\n    kind = \"group\"\n    prepend payload = </S>\n    prepend references = [\n        </S>,\n        @asset.usda@</A> (offset = 2)\n    ]\n    prepend specializes = </S>\n    variants = {\n        string shade = \"dark\"\n    }\n    prepend variantSets = \"shade\"\n)\n{\n    reorder properties = [\"b\", \"a\"]\n    reorder nameChildren = [\"y\", \"x\"]\n    double a = 2\n    double b = 1\n\n    def \"y\"\n    {\n    }\n\n    over \"x\"\n    {\n    }\n    variantSet \"shade\" = {\n        \"dark\" {\n\n        }\n    }\n}\n\n"
