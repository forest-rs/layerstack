def "FS_over" (
    prepend references = @./lib/weak.usda@</FS_over_Rig>
)
{
    over Sphere "New"
    {
        double radius.timeSamples = { 1: 5, 3: 7 }
        float3[] extent = edit [write (9, 9, 9) to [1]]
        token visibility.timeSamples = { 1: "invisible", 3: "inherited" }
    }

}

def "FA_none" (
    prepend references = @./lib/weak.usda@</FA_none_Rig>
