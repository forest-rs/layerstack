    float[] es_arr.timeSamples = { 1: [10, 20], 3: [30, 40] }
    float[] esd_arr = [1, 2]
    double cdw_dbl = 1.5 (
        customData = {
            string a = "weak"
            int w = 1
            timecode t = 3
            asset p = @./weak.usda@
            dictionary n = {
                int x = 1
                string y = "weak"
            }
        }
    )
    timecode both_tc = 1.5
    timecode both_tc.timeSamples = { 1: 10, 3: 30 }
