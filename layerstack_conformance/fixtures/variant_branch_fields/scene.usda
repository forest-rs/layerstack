#usda 1.0
def "V" (
    variants = {
        string v = "x"
    }
    prepend variantSets = "v"
)
{
    variantSet "v" = {
        "x" (
            active = false
        ) {
            def "Child" {}
        }
    }
}

def "I" (
    variants = {
        string v = "x"
    }
    prepend variantSets = "v"
)
{
    variantSet "v" = {
        "x" (
            instanceable = true
            prepend references = </Proto>
        ) {
        }
    }
}

def "Proto" {
    def "Leaf" {}
}
