def "Rock" (
    delete variantSets = "gone"
    prepend variantSets = "size"
    variants = {
        string size = "big"
    }
)
{
    variantSet "size" = {
        "big" {
            double height = 2
            def "Pebble"
            {
                double radius = 1
            }
        }
        "small" {
        }
    }
}

def "Plant" (
    variantSets = "leaf"
)
{
}

