#usda 1.0

over "Prepends" (
    prepend variantSets = ["a", "b"]
)
{
    variantSet "a" = {
        "on" {
            double weight = 1
            bool from_a = 1
        }
    }
    variantSet "b" = {
        "on" {
            double weight = 2
            bool from_b = 1
        }
    }
    variantSet "c" = {
        "on" {
            double weight = 3
            bool from_c = 1
        }
    }
    variantSet "d" = {
        "on" {
            double weight = 4
            bool from_d = 1
        }
    }
}

