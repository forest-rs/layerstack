over "NestedStack" (
    prepend variantSets = "shape"
)
{
    variantSet "shape" = {
        "round" (
            prepend variantSets = ["size", "finish"]
        ) {
            variantSet "finish" = {
                "matte" {
                    double gloss = 0.25
                }
            }
            variantSet "size" = {
                "big" {
                    double height = 3
                }
            }
        }
    }
}
