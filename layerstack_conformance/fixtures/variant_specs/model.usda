#usda 1.0

def "Model" (
    prepend variantSets = "light"
    variants = {
        string light = "dim"
        string shade = "pale"
    }
)
{
    variantSet "light" = {
        "dim" (
            prepend variantSets = "shade"
        ) {
            int glow = 1
            variantSet "shade" = {
                "pale" {
                    int tone = 1
                    def "Mist"
                    {
                    }
                }
                "dark" {
                    int tone = 2
                    def "Shadow"
                    {
                    }
                }
            }
        }
        "bright" (
            prepend variantSets = "shade"
        ) {
            int glow = 5
            variantSet "shade" = {
                "pale" {
                    int tone = 3
                    def "Haze"
                    {
                    }
                }
                "dark" {
                    int tone = 4
                }
            }
        }
    }
}
