def Xform "Asset"
{
    uniform token purpose = "render"
    double3 xformOp:translate = (10, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Xform "Part"
    {
        double xformOp:rotateX = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX"]
    }

    def Xform "Hidden"
    {
        token visibility = "invisible"
    }

    def Xform "Plain"
    {
    }
}
