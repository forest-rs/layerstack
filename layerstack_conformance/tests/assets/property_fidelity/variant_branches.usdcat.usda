#usda 1.0
(
    defaultPrim = "Model"
)

def "Model" (
    variants = {
        string lod = "low"
    }
    prepend variantSets = "lod"
)
{
    variantSet "lod" = {
        "high" {
            def "Geom"
            {
                int detail = 2

                def "Mesh"
                {
                    uniform token purpose = "render"
                }
            }

        }
        "low" {
            def "Geom"
            {
                int detail = 1

                def "Mesh"
                {
                    uniform token purpose = "proxy"
                }
            }

        }
    }
}

