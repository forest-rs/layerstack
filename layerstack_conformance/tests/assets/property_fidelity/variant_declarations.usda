#usda 1.0
def "P" (
    variantSets = ["v"]
    variants = { string v = "b" }
) {
    variantSet "v" = {
        "a" {
            def Mesh "C"
            {
            reorder properties = ["a"]
            double a = 1
            }
        }
        "b" {
            class Xform "C"
            {
            reorder properties = ["b"]
            double b = 2
            }
        }
    }
}
