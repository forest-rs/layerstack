#usda 1.0
(
    defaultPrim = "Robot"
    doc = "A robot asset: the sample references it, and its finish variants refine it: its paint reads the displayColor primvar they author."
)

def Xform "Robot" (
    kind = "component"
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    color3f color = (0.5, 0.5, 0.5)
    double roughness = 0.6
    double height = 1.2
    rel material:binding = </Robot/Looks/Paint>

    def Cube "Body"
    {
        double size = 1
        double3 xformOp:translate = (0, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Head"
    {
        double radius = 0.4
        double3 xformOp:translate = (0, 1.4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "Paint"
        {
            token outputs:surface.connect = </Robot/Looks/Paint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Robot/Looks/Paint/Finish.outputs:result>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "Finish"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                string inputs:varname = "displayColor"
                float3 inputs:fallback = (0.5, 0.5, 0.5)
                float3 outputs:result
            }
        }
    }
}
