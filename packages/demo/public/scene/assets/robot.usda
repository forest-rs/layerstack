#usda 1.0
(
    defaultPrim = "Robot"
    doc = "A robot asset: the sample references it, and its finish variants refine it."
)

def Xform "Robot" (
    kind = "component"
)
{
    color3f color = (0.5, 0.5, 0.5)
    double roughness = 0.6
    double height = 1.2

    def Cube "Body"
    {
        double size = 1
    }

    def Sphere "Head"
    {
        double radius = 0.4
    }
}
