#usda 1.0
(
    doc = "A sublayer of the sample: the class its shapes inherit, and a lamp that aims at the robot and flickers out at time 24."
)

class "Shape"
{
    double radius = 2
    color3f color = (0.4, 0.4, 0.4)
}

over "World"
{
    def SphereLight "Lamp"
    {
        float inputs:intensity = 500
        color3f inputs:color = (1, 0.9, 0.7)
        double flicker.timeSamples = {
            0: 0.2,
            12: 0.8,
            24: None,
        }
        rel aim = </World/Robot>
    }
}
