#usda 1.0
(
    doc = "A sublayer of the sample: the class its shapes inherit, and a lamp."
)

class "Shape"
{
    double radius = 2
    color3f color = (0.4, 0.4, 0.4)
}

over "World"
{
    def SphereLight "Lamp"
    {
        float inputs:intensity = 500
        color3f inputs:color = (1, 0.9, 0.7)
    }
}
