#usda 1.0
(
    defaultPrim = "World"
    doc = "The demo editor's sample: a root layer, a sublayer, a class the rock inherits, a robot referenced from its own file with a variant set, and two instances of a beacon."
    subLayers = [
        @./library.usda@
    ]
)

def Xform "World"
{
    def Sphere "Rock" (
        inherits = </Shape>
    )
    {
    }

    def Xform "Robot" (
        prepend references = @./assets/robot.usda@
        variants = {
            string finish = "painted"
        }
        prepend variantSets = "finish"
    )
    {
        variantSet "finish" = {
            "chrome" (
                prepend references = @./assets/chrome.usda@
            ) {
                rel mirrors = </World/Robot>
            }
            "painted" {
                color3f color = (0.8, 0.2, 0.1)
            }
        }
    }

    def Xform "Beacons"
    {
        def "North" (
            instanceable = true
            prepend references = @./assets/beacon.usda@
        )
        {
        }

        def "South" (
            instanceable = true
            prepend references = @./assets/beacon.usda@
        )
        {
        }
    }
}
