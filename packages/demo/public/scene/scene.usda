#usda 1.0
(
    defaultPrim = "World"
    doc = "The demo editor's sample: a root layer, a sublayer, a class the rock inherits, a robot referenced from its own file with a variant set, two instances of a beacon, a ground mesh with a face subset, a concave path, a point instancer of stones, a spinning top animated by time samples, a camera and lights, a sign with a checker texture and a strip with UDIM tiles."
    subLayers = [
        @./library.usda@
    ]
)

def Xform "World"
{
    def Sphere "Rock" (
        inherits = </Shape>
    )
    {
        double3 xformOp:translate = (-4, 2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Robot" (
        prepend references = @./assets/robot.usda@
        variants = {
            string finish = "painted"
        }
        prepend variantSets = "finish"
    )
    {
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        variantSet "finish" = {
            "chrome" (
                prepend references = @./assets/chrome.usda@
            ) {
                rel mirrors = </World/Robot>
            }
            "painted" {
                color3f color = (0.8, 0.2, 0.1)
                color3f[] primvars:displayColor = [(0.8, 0.2, 0.1)]
            }
        }
    }

    def Xform "Beacons"
    {
        def "North" (
            instanceable = true
            prepend references = @./assets/beacon.usda@
        )
        {
            double3 xformOp:translate = (-2, 0, -5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "South" (
            instanceable = true
            prepend references = @./assets/beacon.usda@
        )
        {
            double3 xformOp:translate = (2, 0, -5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Mesh "Ground"
    {
        int[] faceVertexCounts = [4, 4]
        int[] faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4]
        point3f[] points = [(-8, 0, 6), (0, 0, 6), (8, 0, 6), (-8, 0, -8), (0, 0, -8), (8, 0, -8)]
        color3f[] primvars:displayColor = [(0.36, 0.42, 0.3), (0.42, 0.38, 0.3)] (
            interpolation = "uniform"
        )
        uniform token subdivisionScheme = "none"

        def GeomSubset "West"
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [0]
        }
    }

    def Mesh "Path"
    {
        int[] faceVertexCounts = [6]
        int[] faceVertexIndices = [0, 1, 2, 3, 4, 5]
        point3f[] points = [(-3, 0.01, 3), (-5, 0.01, 3), (-5, 0.01, 1), (-7, 0.01, 1), (-7, 0.01, 5), (-3, 0.01, 5)]
        color3f[] primvars:displayColor = [(0.62, 0.58, 0.5)]
        normal3f[] normals = [(0, 1, 0)] (
            interpolation = "uniform"
        )
        uniform token subdivisionScheme = "none"
    }

    def Cube "Top"
    {
        double size = 0.6
        color3f[] primvars:displayColor = [(0.2, 0.62, 0.6)]
        double3 xformOp:translate = (5.5, 0.8, 1.5)
        double xformOp:rotateY = 0
        double xformOp:rotateY.timeSamples = {
            0: 0,
            48: 360,
        }
        double xformOp:rotateX = 35
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:rotateX"]
    }

    def Camera "Camera"
    {
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.1, 300)
        double3 xformOp:translate = (10, 7, 14)
        float3 xformOp:rotateXYZ = (-18.4, 33.69, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 2.5
        bool inputs:normalize = true
        color3f inputs:color = (1, 0.95, 0.88)
        float3 xformOp:rotateXYZ = (-55, 40, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 0.35
        color3f inputs:color = (0.62, 0.72, 0.95)
    }

    def DiskLight "Spot" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:radius = 0.15
        float inputs:intensity = 4000
        color3f inputs:color = (0.75, 0.85, 1)
        float inputs:shaping:cone:angle = 30
        float inputs:shaping:cone:softness = 0.4
        double3 xformOp:translate = (3, 5, 0)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def RectLight "Panel"
    {
        float inputs:width = 3
        float inputs:height = 1.2
        float inputs:intensity = 6
        color3f inputs:color = (1, 0.75, 0.5)
        double3 xformOp:translate = (-7.5, 1.5, -2)
        float3 xformOp:rotateXYZ = (0, -90, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def PointInstancer "Stones"
    {
        rel prototypes = </World/Stones/Stone>
        int[] protoIndices = [0, 0, 0, 0, 0]
        point3f[] positions = [(-1, 0.25, 3), (0, 0.25, 3.5), (1, 0.25, 3), (2, 0.25, 3.5), (3, 0.25, 3)]
        quath[] orientations = [(1, 0, 0, 0), (0.92, 0, 0.38, 0), (1, 0, 0, 0), (0.92, 0, -0.38, 0), (1, 0, 0, 0)]
        int64[] ids = [1, 2, 3, 4, 5]
        int64[] invisibleIds = []

        def Cube "Stone"
        {
            double size = 0.5
            color3f[] primvars:displayColor = [(0.55, 0.53, 0.5)]
        }
    }

    def Mesh "Sign" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, 0, 0), (1, 0, 0), (1, 1.5, 0), (-1, 1.5, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        texCoord2f[] primvars:card = [(0, 0), (1.3333334, 0), (1.3333334, 1), (0, 1)] (
            doc = "Square checks on the 2 x 1.5 sign: the set the last step reads."
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Checker>
        double3 xformOp:translate = (-0.5, 0, 1.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Strip" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, 0.02, 0.5), (1, 0.02, 0.5), (1, 0.02, -0.5), (-1, 0.02, -0.5)]
        texCoord2f[] primvars:st = [(0, 0), (2, 0), (2, 1), (0, 1)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Tiles>
        double3 xformOp:translate = (5, 0, -2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "Checker"
        {
            string inputs:coordinates = "st"
            float4 inputs:tint = (1, 1, 1, 1)
            token outputs:surface.connect = </World/Looks/Checker/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Checker/Texture.outputs:rgb>
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname.connect = </World/Looks/Checker.inputs:coordinates>
                float2 outputs:result
            }

            def Shader "Place"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </World/Looks/Checker/Reader.outputs:result>
                float inputs:rotation = 15
                float2 inputs:scale = (2, 2)
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/checker.png@
                float2 inputs:st.connect = </World/Looks/Checker/Place.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale.connect = </World/Looks/Checker.inputs:tint>
                float3 outputs:rgb
            }
        }

        def Material "Tiles"
        {
            token outputs:surface.connect = </World/Looks/Tiles/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Tiles/Texture.outputs:rgb>
                float inputs:roughness = 0.8
                token outputs:surface
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/tile.<UDIM>.png@
                float2 inputs:st.connect = </World/Looks/Tiles/Reader.outputs:result>
                token inputs:sourceColorSpace = "sRGB"
                float3 outputs:rgb
            }
        }
    }
}
