#usda 1.0
(
    defaultPrim = "World"
    doc = "The demo's sample: a root layer, a sublayer, a class the rock inherits, a robot referenced from its own file with a variant set, two instances of a beacon, a ground, and a spot light linked to the robot alone."
    subLayers = [
        @./library.usda@
    ]
)

def Xform "World"
{
    def Sphere "Rock" (
        inherits = </Shape>
    )
    {
    }

    def Xform "Robot" (
        prepend references = @./assets/robot.usda@
        variants = {
            string finish = "painted"
        }
        prepend variantSets = "finish"
    )
    {
        variantSet "finish" = {
            "chrome" (
                prepend references = @./assets/chrome.usda@
            ) {
                rel mirrors = </World/Robot>
            }
            "painted" {
                color3f color = (0.8, 0.2, 0.1)
                color3f[] primvars:displayColor = [(0.8, 0.2, 0.1)]
            }
        }
    }

    def Xform "Beacons"
    {
        def "North" (
            instanceable = true
            prepend references = @./assets/beacon.usda@
        )
        {
        }

        def "South" (
            instanceable = true
            prepend references = @./assets/beacon.usda@
        )
        {
        }
    }

    def Mesh "Ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-8, 0, 6), (8, 0, 6), (8, 0, -8), (-8, 0, -8)]
    }

    def DiskLight "Spot" (
        doc = "Linked to the robot alone: its lightLink collection includes /World/Robot, and not the root."
    )
    {
        float inputs:intensity = 4000
        rel collection:lightLink:includes = </World/Robot>
        uniform bool collection:lightLink:includeRoot = false
    }
}
