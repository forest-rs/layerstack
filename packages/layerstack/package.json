{
  "name": "@forest-rs/layerstack",
  "version": "0.1.0",
  "description": "Open, resolve, inspect and explain USD stages in the browser or Node, over Layerstack compiled to WebAssembly.",
  "license": "Apache-2.0 OR MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forest-rs/layerstack",
    "directory": "packages/layerstack"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "wasm/layerstack.js",
    "wasm/layerstack.d.ts",
    "wasm/layerstack_bg.wasm"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json",
    "size": "node scripts/check-size.mjs",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.4.0",
    "typescript": "5.9.3"
  }
}
